{
  // Cloudflare Workers 정적 자산 배포 설정 (클라이언트 전용).
  //
  // Cloudflare는 저장소 루트에서 빌드하므로 이 파일도 루트에 둔다.
  // 루트 `npm run build`가 client 워크스페이스만 빌드하고,
  // 산출물은 client/dist에 생긴다 (루트 dist가 아니다).
  //
  // 서버(server/, Next.js + Prisma + PostgreSQL)는 여기서 배포하지 않는다.
  // 클라이언트가 호출할 API 주소는 빌드 시점에 VITE_API_URL로 주입한다.
  "name": "no-last-train",
  "compatibility_date": "2026-08-08",

  "assets": {
    "directory": "./client/dist"

    // not_found_handling은 일부러 설정하지 않는다(기본값 = 404).
    // 이 앱의 라우팅은 경로가 아니라 쿼리스트링(?city=, ?verifyToken=)만
    // 사용하므로 SPA 폴백이 필요 없다. 폴백을 켜면 /api/* 요청에도
    // index.html이 200으로 돌아가, VITE_API_URL 미설정이 404가 아니라
    // "JSON 파싱 실패"로 위장되어 원인 파악이 어려워진다.
  }
}
