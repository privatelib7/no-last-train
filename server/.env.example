# API 서버가 listen할 포트.
# 지정하지 않으면 Next 기본값인 3000을 쓰므로, 클라이언트의
# API_PROXY_TARGET 기본값(3001)과 맞추려면 이 값을 유지해야 한다.
# 셸 환경변수로 PORT를 주면 이 값보다 우선한다.
PORT="3001"

# PostgreSQL 연결 문자열
# - 로컬 Docker: postgresql://nlt:nlt@127.0.0.1:5432/no_last_train
# - Supabase (Worker/Node): Session pooler + 비밀번호 URL 인코딩 + sslmode
#   postgresql://postgres.<ref>:<pw-encoded>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=no-verify
# Cloudflare Worker는 wrangler.jsonc의 Hyperdrive 바인딩을 쓰고,
# 로컬 wrangler dev는 .dev.vars에
#   CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<위와 동일 URL>
# 를 둔다.
DATABASE_URL="postgresql://nlt:nlt@127.0.0.1:5432/no_last_train"

# OpenAI API (AI 도시 운영관 명령 해석, 선택)
OPENAI_API_KEY="sk-proj-..."
# 지정하지 않으면 분류·추출용 gpt-5.4-nano를 사용
OPENAI_MODEL="gpt-5.4-nano"

# Anthropic API (기존 노선 정책 자연어 파싱, 선택)
ANTHROPIC_API_KEY="sk-ant-..."

# Gmail SMTP (회원가입 이메일 인증 발송)
# Google 계정 > 보안 > 앱 비밀번호에서 발급
# tip: no-reply / 신규 계정은 스팸으로 가기 쉬움. 평소 쓰는 Gmail을 권장
GMAIL_USER="youraddress@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

# 인증 메일 내 링크가 가리킬 클라이언트 주소
# tip: localhost 링크는 Gmail 스팸 분류 가능성이 높음 (로컬에선 화면의 인증 링크 사용)
APP_BASE_URL="http://localhost:5173"
