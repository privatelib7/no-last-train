{
  // 클라이언트(정적 SPA) 전용 Cloudflare Workers 설정.
  //
  // 이 파일은 반드시 client/ 안에 있어야 한다. 루트에 두면 server/를 Root
  // directory로 쓰는 다른 Worker 프로젝트의 빌드에서도 wrangler가 상위
  // 디렉터리를 거슬러 올라와 이 설정을 집어간다. 그 경우 아래 name으로
  // 배포되므로 서버 쪽 빌드가 클라이언트 Worker를 덮어쓴다.
  //
  // 서버(server/, Next.js + Prisma + PostgreSQL)는 이 설정으로 배포되지
  // 않는다. main 진입점이 없는 정적 자산 전용 구성이다.
  //
  // Cloudflare 빌드 설정 (클라이언트 Worker):
  //   Root directory : client
  //   Build command  : npm run build
  //   Deploy command : npx wrangler deploy
  //
  // 클라이언트가 호출할 API 주소는 빌드 시점에 VITE_API_URL로 주입한다.
  // 비어 있으면 상대경로 /api/... 로 요청하므로 Cloudflare에서 404가 된다.
  "name": "no-last-train",
  "compatibility_date": "2026-08-08",

  "assets": {
    "directory": "./dist"

    // not_found_handling은 일부러 설정하지 않는다(기본값 = 404).
    // 이 앱의 라우팅은 경로가 아니라 쿼리스트링(?city=, ?verifyToken=)만
    // 사용하므로 SPA 폴백이 필요 없다. 폴백을 켜면 /api/* 요청에도
    // index.html이 200으로 돌아가, VITE_API_URL 미설정이 404가 아니라
    // "JSON 파싱 실패"로 위장되어 원인 파악이 어려워진다.
  }
}
