# 이 파일을 .env로 복사해 사용한다 (.env는 gitignore 대상).
# 두 변수 모두 값을 바꾸면 dev 서버 재시작 또는 재빌드가 필요하다.

# dev 서버가 /api 요청을 넘길 백엔드 주소.
# vite.config.ts에서만 읽으며 클라이언트 번들에는 포함되지 않는다.
# 비워두면 http://localhost:3001 을 사용한다.
API_PROXY_TARGET="http://localhost:3001"

# dev 서버가 /ws WebSocket을 넘길 실시간 서버 주소.
# 비워두면 http://localhost:3012 을 사용한다 (server REALTIME_PORT 기본값).
REALTIME_PROXY_TARGET="http://localhost:3012"

# 클라이언트가 API를 호출할 기준 주소 (client/src/api/*.ts).
# 비워두면 상대경로(/api/...)로 요청하며, dev에서는 위 프록시가 처리한다.
# 백엔드가 다른 오리진에 있을 때만 절대 주소를 넣는다.
# Cloudflare Workers Builds(클라이언트 Worker) 빌드 변수로는 아래를 쓴다:
#   VITE_API_URL=https://no-last-train-server.no-last-train.workers.dev
# 주의: VITE_ 접두사가 붙은 값은 번들에 평문으로 박히므로 비밀값을 넣지 않는다.
VITE_API_URL=""
